  "query": "SELECT id, lesson_id, course_id, week_start, day, slot, duration, subject, room,\n                      cancelled, created_at\n               FROM schedule_subs\n               WHERE tenant_id = $1\n                 AND ($2::date IS NULL OR week_start >= $2)\n                 AND ($3::date IS NULL OR week_start <= $3)\n               ORDER BY week_start",
