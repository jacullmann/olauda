  "query": "SELECT r.id, r.report_type, r.reason, r.reporter_id, r.reporter_email,\n                      r.reported_at, r.details,\n                      NOT EXISTS (\n                        SELECT 1 FROM items WHERE id = (r.details->>'itemId')::uuid\n                      ) AS \"content_deleted!\"\n               FROM reports r\n               ORDER BY r.reported_at DESC",
