  "query": "SELECT ur.user_id, ur.assigned_at, ur.role_id,\n                      m.user_id IS NOT NULL AS \"muted!\"\n               FROM user_roles ur\n               LEFT JOIN group_mutes m ON m.tenant_id = ur.tenant_id AND m.user_id = ur.user_id\n               WHERE ur.tenant_id = $1",
