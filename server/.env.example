NODE_ENV=development
VERSION=1.0.0
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=
CORS_ORIGIN=http://localhost:5173
# Passkeys are bound to the frontend. Both default to CORS_ORIGIN and its host.
# Changing WEBAUTHN_RP_ID later makes every registered passkey unusable.
WEBAUTHN_RP_ORIGIN=
WEBAUTHN_RP_ID=
ENCRYPTION_KEY=
USER_JWT_SECRET=
PASSWORD_RESET_JWT_SECRET=
MFA_PENDING_JWT_SECRET=
PORT=3000
RESEND_API_KEY=
EMAIL_FROM="Olauda <noreply@schul-dashboard.com>"
USER_KEY_PEPPER=
OAUTH_PENDING_JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Blank issues host-only cookies, e.g. to reach a dev server through a LAN IP.
COOKIE_DOMAIN=localhost
DATABASE_URL=
GEOIP_SERVICE_URL=http://geoip-service:8080
# Server metrics in the superadmin overview; a read-only token is enough.
HETZNER_API_TOKEN=
HETZNER_SERVER_ID=
